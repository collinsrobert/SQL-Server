<Create xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
  <ObjectDefinition>
    <Trace>
      <ID>XE_Tabular_Processing</ID>
      <Name>XE_Tabular_Processing</Name>
      <XEvent xmlns="http://schemas.microsoft.com/analysisservices/2011/engine/300/300">
        <event_session name="XE_Tabular_Processing" dispatchLatency="1" maxEventSize="0" maxMemory="4" memoryPartition="PerCpu" eventRetentionMode="AllowSingleEventLoss" trackCausality="true" xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
          <event package="AS" name="CommandBegin" />
          <event package="AS" name="CommandEnd" />
          <event package="AS" name="ProgressReportBegin" />
          <event package="AS" name="ProgressReportEnd" />
          <event package="AS" name="AuditLogin" />
          <event package="AS" name="AuditLogout" />
          <event package="AS" name="UserDefined" />
          <event package="AS" name="VertiPaqSEQueryBegin" />
          <event package="AS" name="VertiPaqSEQueryEnd" />
          <target package="package0" name="event_file">
            <parameter name="filename" value="J:\SYSDB\MSAS16.MSSQLSERVER\OLAP\Log\XE_Tabular_Processing.xel" />
            <parameter name="max_file_size" value="4096" />
            <parameter name="max_rollover_files" value="10" />
            <parameter name="increment" value="1024" />
          </target>
        </event_session>
      </XEvent>
    </Trace>
  </ObjectDefinition>
</Create>





----read this from sql server engine
SELECT
    object_name AS event_name,
    CAST(event_data AS XML) AS event_xml,
    file_name,
    file_offset
FROM sys.fn_xe_file_target_read_file(
    N'J:\SYSDB\MSAS16.MSSQLSERVER\OLAP\Log\XE_Tabular_Processing*.xel',
    NULL,
    NULL,
    NULL
)
ORDER BY file_name, file_offset;










SELECT
    timestamp_utc,
    file_name,
    file_offset,
    CAST(event_data AS xml) AS event_xml
INTO #xe
FROM sys.fn_xe_file_target_read_file(N'J:\xe\XE_Tabular_Processing*.xel', NULL, NULL, NULL) ----EVENT FILE PATH
WHERE 
--timestamp_utc >= '2026-10-12T13:00:00'      -- UTC, see note below
--  AND timestamp_utc <  '2026-10-12T13:30:00'
   event_data LIKE N'%Monthly Sales M - Live Forecast%'; -----CUBE NAME
 
-- 2) Shred out the fields you care about
SELECT
    timestamp_utc,
    event_xml.value('(/event/@name)[1]', 'varchar(100)')                                   AS event_name,
    event_xml.value('(/event/data[@name="NTUserName"]/value)[1]', 'nvarchar(256)')          AS nt_user_name,
    event_xml.value('(/event/data[@name="DatabaseName"]/value)[1]', 'nvarchar(256)')        AS database_name,
    event_xml.value('(/event/data[@name="TextData"]/value)[1]', 'nvarchar(max)')            AS command_text,
    event_xml.value('(/event/data[@name="Duration"]/value)[1]', 'bigint')                   AS duration_ms,
    event_xml.value('(/event/data[@name="Success"]/value)[1]', 'int')                       AS success,
    event_xml.value('(/event/data[@name="ConnectionID"]/value)[1]', 'bigint')               AS connection_id,
    event_xml.value('(/event/data[@name="SessionID"]/value)[1]', 'varchar(50)')             AS session_id,
    event_xml.value('(/event/data[@name="RequestID"]/value)[1]', 'varchar(50)')             AS request_id,
    event_xml                                                                                AS full_event_xml
FROM #xe
WHERE event_xml.value('(/event/@name)[1]', 'varchar(100)')
      IN ('CommandBegin','CommandEnd','QueryBegin','QueryEnd')   -- skip VertiPaqSE noise
ORDER BY timestamp_utc;
